{
  "_comment": "Hardened seccomp: default-allow with explicit blocks for SYS_ADMIN escape vectors",
  "defaultAction": "SCMP_ACT_ALLOW",
  "syscalls": [
    {
      "_comment": "BLOCKED: debugger/memory access - prevents attaching to other processes",
      "names": [
        "ptrace",
        "process_vm_readv",
        "process_vm_writev"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: kernel module loading - prevents code injection into kernel",
      "names": [
        "init_module",
        "finit_module",
        "delete_module"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: eBPF and perf - prevents kernel-level tracing and manipulation",
      "names": [
        "bpf",
        "perf_event_open"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: dangerous system operations",
      "names": [
        "kexec_load",
        "kexec_file_load",
        "reboot",
        "swapon",
        "swapoff",
        "acct",
        "lookup_dcookie",
        "syslog"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: file handle operations that bypass DAC",
      "names": [
        "open_by_handle_at",
        "name_to_handle_at"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: userfaultfd can be used for race condition exploits",
      "names": [
        "userfaultfd"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: io_uring has large kernel attack surface with SYS_ADMIN",
      "names": [
        "io_uring_setup",
        "io_uring_enter",
        "io_uring_register"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "_comment": "BLOCKED: legacy x86 vm manipulation (not needed for containers)",
      "names": [
        "vm86",
        "vm86old",
        "modify_ldt"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
